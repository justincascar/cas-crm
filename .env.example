# Email send mode. simulate records the email on the file and does not contact Microsoft.
# live sends from claims@cascar.co.uk, and only when the three CAS_M365_* values below are also set.
# Anything other than the exact value live is treated as simulate. Credentials alone do not send.
EMAIL_SEND_MODE=simulate

# Optional Microsoft 365 send-as claims@cascar.co.uk.
# Leave all three unset until the app registration exists. They are required for a live send,
# and they do not send by themselves. Do not commit real values. .env is ignored by git.
# CAS_M365_TENANT_ID=
# CAS_M365_CLIENT_ID=
# CAS_M365_CLIENT_SECRET=

# Licensed Royal Mail PAF drop-down (leave unset to keep the free postcode lookup)
# IDEAL_POSTCODES_API_KEY=

# Optional overrides for demonstration staff passwords (see docs/AUTH-NOTES.md).
# If unset, the fictional CasDemo.<Name> values in AUTH-NOTES.md are used on first seed.
# CAS_DEMO_PASSWORD_JUSTIN=
# CAS_DEMO_PASSWORD_SIAN=
# CAS_DEMO_PASSWORD_TOM=
# CAS_DEMO_PASSWORD_MEGAN=
